{
  "name": "song-project",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "npm run db:migrate:local && wrangler dev",
    "start": "npm run dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "jlpt:materialize-production": "node scripts/jlpt/materialize-production.mjs && node scripts/jlpt/refine-materialized-daily.mjs && node scripts/jlpt/sanitize-materialized-production.mjs",
    "jlpt:validate": "npm run jlpt:materialize-production && node scripts/jlpt/validate-production.mjs",
    "jlpt:validate-production": "npm run jlpt:materialize-production && node scripts/jlpt/validate-production.mjs",
    "jlpt:build-production": "npm run jlpt:materialize-production && node scripts/jlpt/build-production-migration.mjs && node scripts/jlpt/make-d1-compatible-production-migration.mjs",
    "jlpt:build-word-drafts": "node scripts/jlpt/build-word-enrichment-drafts.mjs",
    "d1:lint-migrations": "node scripts/d1/lint-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply song-project-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply song-project-db --remote",
    "seed:test:local": "wrangler d1 execute song-project-db --local --file=./seeds/test_data.sql",
    "seed:test:remote": "wrangler d1 execute song-project-db --remote --file=./seeds/test_data.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.127.0"
  }
}
